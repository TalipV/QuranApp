<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <LinearLayout
      android:id="@+id/toolbar_area"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@color/toolbar">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolBarArea"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/ToolbarStyle"
        app:popupTheme="@style/ThemeOverlay.AppCompat"
        app:subtitleTextAppearance="@style/ToolbarSubtitleText"
        app:titleTextAppearance="@style/ToolbarTitleText" />

    <com.quran.labs.androidquran.view.SlidingTabLayout
        android:id="@+id/indicator"
        style="@style/ToolBarArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
  </LinearLayout>

  <!-- QuranApp: Karten „Weiterlesen“ für laufende Rezitationen (ReadingProgressHomeSection) -->
  <LinearLayout
      android:id="@+id/reading_progress_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:visibility="gone" />

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <com.quran.labs.androidquran.view.QuranViewPager
        android:id="@+id/index_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- QuranApp: Stelle per Rezitation finden -->
    <ImageButton
        android:id="@+id/recitation_finder"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|right"
        android:layout_margin="16dp"
        android:background="@drawable/bg_tilawa_fab"
        android:contentDescription="@string/quranapp_find_by_recitation"
        android:elevation="6dp"
        android:src="@drawable/ic_tilawa_mic" />
  </FrameLayout>
</LinearLayout>
